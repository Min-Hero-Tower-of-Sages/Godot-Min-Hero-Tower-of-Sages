; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Min Hero: Tower of Sages"
run/main_scene="res://scenes/application_shell.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

CampaignRuntime="*res://src/application/campaign_runtime.gd"
NetSession="*res://src/application/multiplayer_session.gd"

[display]

window/size/viewport_width=700
window/size/viewport_height=525
window/size/window_width_override=1050
window/size/window_height_override=788
window/stretch/mode="canvas_items"

